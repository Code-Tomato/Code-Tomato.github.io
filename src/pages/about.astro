---
import BaseLayout from '../layouts/BaseLayout.astro';
import { skills } from '../data/experience';

const scholarships = ['Samsung Scholarship', 'Santander Scholarship', 'Albert & Jessie Cudlipp Scholarship'];
const leadership = ['Students4Hope (Founder)', 'SEO USA', 'Ron Brown Scholar', 'ColorStack', 'NSBE'];

const coursework = [
  'Distributed Systems (Grad)',
  'Systems for Machine Learning (Grad)',
  'Multithreading & GPUs',
  'Multicore Computing',
  'Operating Systems',
  'Compilers',
  'Computer Architecture',
];

---

<BaseLayout
  title="About"
  description="Nathan Lemma: ECE at UT Austin, 2023-2027. Education, skills, scholarships and leadership, and what I do away from the screen."
>
  <!-- Page head -->
  <section class="page-head">
    <div class="container">
      <div class="sec-head">
        <span class="sec-label">About</span>
        <span class="sec-aside">BS ECE · 2023–2027</span>
      </div>
      <h1 class="display">Who am I?</h1>
      <p class="lede page-lede">
        Hardware → embedded → OS and ML.
      </p>

    </div>
  </section>


  <!-- 01 / EDUCATION -->
  <section class="section-tight" aria-labelledby="education-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">01</span>
        <span class="sec-label" id="education-heading">Education</span>
      </div>
      <div class="prose">
        <p>
          <strong>The University of Texas at Austin</strong><br />
          BS, Electrical and Computer Engineering, <time datetime="2023-08">Aug 2023</time> – <time
            datetime="2027-05">May 2027</time>
        </p>
        <p class="label coursework">{coursework.join(' · ')}</p>
      </div>
    </div>
  </section>

  <!-- 02 / SKILLS -->
  <section class="section-tight" aria-labelledby="skills-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">02</span>
        <span class="sec-label" id="skills-heading">Skills</span>
      </div>
      <dl class="fact-list">
        {
          skills.map((group) => (
            <div class="fact-row">
              <dt>{group.group}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 03 / RECOGNITION -->
  <section class="section-tight" aria-labelledby="awards-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">03</span>
        <span class="sec-label" id="awards-heading">Awards &amp; leadership</span>
      </div>
      <dl class="fact-list">
        <div class="fact-row">
          <dt>Scholarships</dt>
          <dd>{scholarships.join(' · ')}</dd>
        </div>
        <div class="fact-row">
          <dt>Leadership &amp; community</dt>
          <dd>{leadership.join(' · ')}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 04 / BEYOND -->
  <section class="section-tight" aria-labelledby="beyond-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">04</span>
        <span class="sec-label" id="beyond-heading">Beyond the code</span>
      </div>
      <div class="prose">
        <p>
          Away from work I play percussion and bike around Austin.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>

  /* ---- compact fact sections ---- */
  .fact-list {
    display: grid;
    border-bottom: 1px solid var(--line-2);
    max-width: 60rem;
  }

  .fact-row {
    display: grid;
    gap: var(--space-1) var(--space-8);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line-2);
  }

  @media (min-width: 768px) {
    .fact-row {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  .fact-row dt {
    font-weight: 700;
    color: var(--ink);
  }

  .fact-row dd {
    color: var(--ink-2);
  }

  .coursework {
    color: var(--ink-3);
  }

  /* Sections here are short facts, not prose, so they sit close together and
     let the sec-head rules do the separating. */
  .section-tight { padding-block-end: var(--grid); }
</style>
