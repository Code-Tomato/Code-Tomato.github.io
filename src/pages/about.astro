---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience, skills } from '../data/experience';
import type { ExperienceEntry } from '../data/experience';

// Approved copy deck: copy.sectionCopy → section "about" (three paragraphs;
// third paragraph rewritten per the round-2 publication policy — contributor
// framing, baselines emphasis, no unpublished results).
const narrative: { eras: string[]; text: string }[] = [
  {
    eras: ['2023 · FSAE bench', '2024 · Caterpillar'],
    text: `On UT's Formula SAE team I led battery-management system design: RTOS firmware and a state-of-charge algorithm that kept range estimates within 5%. At Caterpillar I built HAL and API layers for engine control modules, which is now in production.`,
  },
  {
    eras: ['2025 · kernels & concurrency'],
    text: `I built out Pintos (user processes, syscalls, virtual memory, and a file system) and wrote an instruction-accurate RISC-V simulator for UT's Primate compiler research. I also benchmarked concurrent hash tables and radix trees, which reached over 88 million operations per second. On real LLM traffic, their tail latency was about 40× worse than random benchmarks suggested.`,
  },
  {
    eras: ["2026 · SOSP '26"],
    text: `At UT Austin I work on systems for ML: GPU scheduling that treats energy as a first-class resource. I designed and tested the multi-GPU serving baselines (GPUlets and USHER, reimplemented from their papers) used in a SOSP '26 paper's evaluation. At Caterpillar I'm on my third team in two years, building data tooling in .NET and AWS Lambda to replace manual processes.`,
  },
];

// Experience, grouped by track; consecutive same-org entries fold into one
// org block so the Caterpillar three-role run reads as a progression.
interface OrgGroup {
  org: string;
  roles: ExperienceEntry[];
}

const groupByOrg = (entries: ExperienceEntry[]): OrgGroup[] => {
  const groups: OrgGroup[] = [];
  for (const entry of entries) {
    const last = groups[groups.length - 1];
    if (last && last.org === entry.org) {
      last.roles.push(entry);
    } else {
      groups.push({ org: entry.org, roles: [entry] });
    }
  }
  return groups;
};

const tracks = [
  { label: 'Research', groups: groupByOrg(experience.filter((e) => e.track === 'research')) },
  { label: 'Industry', groups: groupByOrg(experience.filter((e) => e.track === 'industry')) },
  { label: 'Community', groups: groupByOrg(experience.filter((e) => e.track === 'community')) },
];

// Entries are newest-first, so a group spans oldest start → newest end.
const groupPeriod = (roles: ExperienceEntry[]): string => {
  const start = roles[roles.length - 1]?.period.split(' – ')[0] ?? '';
  const end = roles[0]?.period.split(' – ')[1] ?? '';
  return `${start} – ${end}`;
};

const inProductionRole = 'Embedded Software Intern, Platform Software';

const scholarships = ['Samsung Scholarship', 'Santander Scholarship', 'Albert & Jessie Cudlipp Scholarship'];
const leadership = ['Students4Hope (Founder)', 'SEO USA', 'Ron Brown Scholar', 'ColorStack', 'NSBE'];

const coursework = [
  'Multicore Computing',
  'Embedded Systems',
  'Operating Systems',
  'Computer Architecture',
  'Software Engineering',
];
---

<BaseLayout
  title="About"
  description="Nathan Lemma's path from race-car battery firmware to GPU scheduling research — ECE at UT Austin, contributor to a SOSP '26 paper."
>
  <!-- Page head + narrative -->
  <section class="page-head">
    <div class="container">
      <h1 class="display">From the metal up</h1>
      <p class="lede page-lede">
        One path, in order: hardware, then embedded, then operating systems and concurrency, then systems for ML.
      </p>

      <div class="narrative">
        {
          narrative.map((row) => (
            <div class="narrative-row">
              <p class="label narrative-era">{row.eras.join(' — ')}</p>
              <div class="prose">
                <p>{row.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 01 / EXPERIENCE -->
  <section class="section section-gray" aria-labelledby="experience-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">01</span>
        <span class="sec-label" id="experience-heading">Experience</span>
        <span class="sec-aside">two tracks · one direction</span>
      </div>

      {
        tracks.map((track) => (
          <div class="xp-track">
            <h3 class="xp-track-title">{track.label}</h3>
            <ul class="xp-list">
              {track.groups.map((g) =>
                g.roles.length === 1 ? (
                  <li class="xp-entry prose">
                    <div class="xp-head">
                      <p class="xp-title">
                        <span class="xp-org">{g.org}</span>
                        <span class="xp-role">{g.roles[0].role}</span>
                      </p>
                      <p class="label xp-period">{g.roles[0].period}</p>
                    </div>
                    <ul class="xp-bullets">
                      {g.roles[0].bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li class="xp-entry xp-group">
                    <div class="xp-head">
                      <p class="xp-title">
                        <span class="xp-org">{g.org}</span>
                      </p>
                      <p class="label xp-period">{groupPeriod(g.roles)}</p>
                    </div>
                    <p class="label xp-progression">
                      three teams in two years · HAL → diagnostics → data &amp; analytics
                    </p>
                    <ol class="xp-roles">
                      {g.roles.map((r) => (
                        <li class="xp-role-item prose">
                          <div class="xp-head">
                            <p class="xp-title">
                              <span class="xp-role-name">{r.role}</span>
                              {r.role === inProductionRole && (
                                <span class="label stamp">in production</span>
                              )}
                            </p>
                            <p class="label xp-period">{r.period}</p>
                          </div>
                          <ul class="xp-bullets">
                            {r.bullets.map((b) => (
                              <li>{b}</li>
                            ))}
                          </ul>
                        </li>
                      ))}
                    </ol>
                  </li>
                )
              )}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 02 / SKILLS -->
  <section class="section-tight" aria-labelledby="skills-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">02</span>
        <span class="sec-label" id="skills-heading">Skills</span>
      </div>
      <dl class="fact-list">
        {
          skills.map((group) => (
            <div class="fact-row">
              <dt>{group.group}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 03 / EDUCATION -->
  <section class="section-tight" aria-labelledby="education-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">03</span>
        <span class="sec-label" id="education-heading">Education</span>
      </div>
      <div class="prose">
        <p>
          <strong>The University of Texas at Austin</strong> — BS, Electrical and Computer
          Engineering, <time datetime="2023-08">Aug 2023</time> – <time datetime="2027-05">May 2027</time> · Minor
          in Business · Humanitarian Engineering certificate
        </p>
        <p class="label coursework">{coursework.join(' · ')}</p>
      </div>
    </div>
  </section>

  <!-- 04 / RECOGNITION -->
  <section class="section-tight" aria-labelledby="awards-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">04</span>
        <span class="sec-label" id="awards-heading">Awards &amp; leadership</span>
      </div>
      <dl class="fact-list">
        <div class="fact-row">
          <dt>Scholarships</dt>
          <dd>{scholarships.join(' · ')}</dd>
        </div>
        <div class="fact-row">
          <dt>Leadership &amp; community</dt>
          <dd>{leadership.join(' · ')}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 05 / BEYOND -->
  <section class="section-tight" aria-labelledby="beyond-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">05</span>
        <span class="sec-label" id="beyond-heading">Beyond the code</span>
      </div>
      <div class="prose">
        <p>
          Away from work I play percussion and bike around Austin.
        </p>
      </div>
    </div>
  </section>

  <!-- Close -->
  <section class="section-tight close-sec">
    <div class="container">
      <hr class="rule-heavy" aria-hidden="true" />
      <div class="cta-row">
        <a href="/projects" class="btn btn-primary">Explore the work</a>
        <a href="/contact" class="btn btn-secondary">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- page head + narrative ---- */
  .page-head {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) var(--section-pad);
  }

  .page-lede {
    margin-top: var(--space-4);
  }

  .narrative {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    display: grid;
    gap: var(--space-8);
    max-width: 46rem;
  }

  .narrative-row {
    border-top: 1px solid var(--line-soft);
    padding-top: var(--space-4);
  }

  .narrative-era {
    color: var(--accent);
    margin-bottom: var(--space-3);
  }

  /* ---- experience ---- */
  .xp-track + .xp-track {
    margin-top: var(--space-12);
  }

  .xp-track-title {
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-4);
  }

  .xp-list {
    list-style: none;
    border-bottom: 2px solid var(--line);
  }

  .xp-entry {
    padding-block: var(--space-6);
    border-top: 2px solid var(--line);
  }

  .xp-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1) var(--space-6);
  }

  .xp-title {
    font-weight: 500;
    max-width: none;
  }

  .xp-org {
    display: block;
    font-weight: 700;
    color: var(--ink);
  }

  .xp-role {
    display: block;
    color: var(--ink-2);
  }

  .xp-period {
    color: var(--ink-3);
    white-space: nowrap;
  }

  .xp-bullets {
    margin-top: var(--space-3);
  }

  .xp-bullets li + li {
    margin-top: var(--space-2);
  }

  /* Caterpillar progression: shared org header, roles off one heavy trace */
  .xp-progression {
    margin-top: var(--space-2);
    color: var(--ink-3);
  }

  .xp-roles {
    list-style: none;
    margin-top: var(--space-6);
    border-left: 2px solid var(--line);
    padding-left: var(--space-6);
  }

  .xp-role-item + .xp-role-item {
    margin-top: var(--space-8);
  }

  .xp-role-name {
    color: var(--ink);
    font-weight: 700;
  }

  .stamp {
    color: var(--accent);
    border: 2px solid var(--accent);
    padding: 0.2rem 0.45rem;
    margin-left: var(--space-3);
    white-space: nowrap;
  }

  /* ---- compact fact sections ---- */
  .section-tight {
    padding-block: var(--space-8) var(--space-12);
  }

  .section-tight .sec-head {
    margin-bottom: var(--space-6);
    border-top-width: 2px;
  }

  .fact-list {
    display: grid;
    border-bottom: 1px solid var(--line-soft);
    max-width: 60rem;
  }

  .fact-row {
    display: grid;
    gap: var(--space-1) var(--space-8);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line-soft);
  }

  @media (min-width: 768px) {
    .fact-row {
      grid-template-columns: 15rem minmax(0, 1fr);
    }
  }

  .fact-row dt {
    font-weight: 700;
    color: var(--ink);
  }

  .fact-row dd {
    color: var(--ink-2);
  }

  .coursework {
    color: var(--ink-3);
  }

  /* ---- close ---- */
  .close-sec {
    padding-bottom: var(--space-16);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-8);
  }
</style>
