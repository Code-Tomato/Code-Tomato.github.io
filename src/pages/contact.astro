---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Reach Nathan Lemma by email, GitHub or LinkedIn. Replies within 24 hours."
>
  <!-- Page head -->
  <section class="page-head">
    <div class="container">
      <div class="sec-head">
        <span class="sec-label">Contact</span>
        <span class="sec-aside">replies within 24h</span>
      </div>
      <h1 class="display">Socials</h1>
      <p class="lede page-lede">
        Email is fastest.
      </p>
    </div>
  </section>

  <!-- The links themselves: the eyebrow above already names the page, so
       there is nothing here for a section head to say. -->
  <section class="section">
    <div class="container">
      <ul class="pin-list">
        <li>
          <a class="pin-row" href="mailto:nlemma@utexas.edu">
            <span class="pin-label"><svg class="pin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><path d="m3 6.5 9 6 9-6" /></svg>Email</span>
            <span class="label pin-value">nlemma@utexas.edu</span>
            <span class="pin-arrow" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a class="pin-row" href="https://github.com/Code-Tomato">
            <span class="pin-label"><svg class="pin-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>GitHub</span>
            <span class="label pin-value">github.com/Code-Tomato</span>
            <span class="pin-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
        <li>
          <a class="pin-row" href="https://linkedin.com/in/nathanylemma">
            <span class="pin-label"><svg class="pin-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>LinkedIn</span>
            <span class="label pin-value">linkedin.com/in/nathanylemma</span>
            <span class="pin-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .pin-list {
    list-style: none;
    border-bottom: 1.5px solid var(--line-2);
  }
  .pin-row {
    display: grid;
    grid-template-columns: minmax(6rem, 10rem) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1.5px solid var(--line-2);
    text-decoration: none;
    color: inherit;
  }
  .pin-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink);
  }

  /* currentColor throughout, so the mark picks up the row's hover with the
     label instead of needing its own rule */
  .pin-icon {
    width: 0.85em;
    height: 0.85em;
    flex: none;
  }
  .pin-value { color: var(--ink-2); overflow-wrap: anywhere; text-transform: none; letter-spacing: 0.02em; }
  .pin-arrow { font-size: 1.25rem; font-weight: 700; color: var(--hot); transition: translate 120ms var(--ease); }
  .pin-row:hover .pin-label { color: var(--hot); }
  .pin-row:hover .pin-arrow { translate: 4px 0; }

  @media (max-width: 480px) {
    .pin-row { grid-template-columns: minmax(0, 1fr) auto; }
    .pin-value { grid-column: 1; grid-row: 2; }
    .pin-arrow { grid-row: 1 / span 2; align-self: center; }
  }
</style>
