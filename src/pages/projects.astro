---
import { publication, orcidUrl } from '../data/experience';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects, getFeaturedProjects } from '../data/projects';

const featured = getFeaturedProjects();
// Everything that isn't featured, in the same order the index uses, so the
// numbering below picks up where the featured grid leaves off.
const rest = projects.filter((p) => p.tier !== 'featured');

// Position in the full project list, so a project keeps one number wherever
// it appears.
const nn = (p: { slug: string }) =>
  String(projects.findIndex((x) => x.slug === p.slug) + 1).padStart(2, '0');

const restYears = rest.map((p) => Number(p.date.slice(0, 4)));
const restSpan = `${Math.min(...restYears)}–${Math.max(...restYears)}`;
---

<BaseLayout
  title="Projects"
  description="Twelve projects: a SOSP '26 publication, GPU scheduling, concurrent data structures, an OS kernel, and the hardware I started on."
>
  <!-- Page head -->
  <section class="page-head">
    <div class="container">
      <div class="sec-head">
        <span class="sec-label">Projects</span>
        <span class="sec-aside">12 projects · updated 2026-09</span>
      </div>
      <h1 class="display">Papers and detours</h1>
      <p class="lede page-lede">
        Write-ups and numbers included. GitHub links sold separately.
      </p>
    </div>
  </section>


  <!-- 00 / PUBLICATION. Numbered 00 because it is the bonus track: it sits
       ahead of the numbered sections rather than inside them. -->
  <section class="section-tight" aria-labelledby="pub-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">00</span>
        <h2 class="sec-label" id="pub-heading">Publication</h2>
        <span class="sec-aside">DOI {publication.doi}</span>
      </div>

      <!-- Venue and status live in the citation, not the aside: phones hide
           every .sec-aside, and a citation without its venue is half of one. -->
      <p class="pub-line">
        <em class="pub-title">“{publication.title}”</em>, {publication.authorship},{' '}
        <span class="pub-venue">{publication.venue} ({publication.note})</span>.{' '}
        {publication.line}
        <span class="pub-links">
          <a class="link-dir" href={publication.paper}>Read paper (ACM) ↗</a>
          <a class="link-dir" href={publication.repo}>EnerTune repo ↗</a>
          <a class="link-dir" href="/projects/serving-baselines">The baselines I built →</a>
          <a class="link-dir" href={orcidUrl}>ORCID ↗</a>
        </span>
      </p>
    </div>
  </section>
  <!-- 01 / FEATURED -->
  <section class="section-tight" aria-labelledby="featured-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">01</span>
        <h2 class="sec-label" id="featured-heading">Featured</h2>
        <span class="sec-aside">current research &amp; systems</span>
      </div>

      <ul class="card-grid">
        {
          featured.map((p) => (
            <li>
              <a class="card" href={`/projects/${p.slug}`}>
                <span class="label card-no">{nn(p)}</span>
                <h3 class="card-title">{p.title}</h3>
                <p class="card-desc">{p.summary}</p>
                <span class="label card-year"><time datetime={p.date}>{p.dateDisplay}</time></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 02 / EVERYTHING ELSE -->
  <section class="section-tight" aria-labelledby="rest-heading">
    <div class="container">
      <div class="sec-head">
        <span class="sec-index">02</span>
        <h2 class="sec-label" id="rest-heading">Everything else</h2>
        <span class="sec-aside">{restSpan}</span>
      </div>

      <ol class="idx-list">
        {
          rest.map((p) => (
            <li>
              <a class="idx-row" href={`/projects/${p.slug}`}>
                <span class="label idx-no">{nn(p)}</span>
                <span class="idx-title">{p.title}</span>
                <span class="idx-desc">{p.summary}</span>
                <span class="label idx-year"><time datetime={p.date}>{p.date.slice(0, 4)}</time></span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* One line, not a paragraph: the global 46ch measure is there to keep prose
     readable and only breaks this in half. The container still holds it. */
  .page-lede { max-width: none; }

  /* ---- 00 / the paper ---- */
  .pub-line {
    display: block;
    color: var(--ink-2);
  }

  .pub-title { color: var(--ink); font-style: italic; }

  /* the venue reads as a readout, like the dates and indices */
  .pub-venue {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--ink);
    white-space: nowrap;
  }

  /* The two links are their own row under the citation. They used to be bare
     inline-blocks in the paragraph, which let them trail off the last line of
     prose with no gap whenever the text happened to wrap short. Flex so a
     narrow screen breaks between links, never inside one. */
  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
  }

  /* ---- 01 / featured: one card per project ---- */
  .card-grid {
    list-style: none;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 680px) {
    .card-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--line-2);
    text-decoration: none;
    color: inherit;
  }

  .card:hover {
    border-color: color-mix(in oklch, var(--hot) 55%, transparent);
  }

  .card-no { color: var(--hot); }

  /* an h3 under the section's h2, still set at the h2 size it always had */
  .card-title {
    font-size: var(--text-h2);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .card:hover .card-title { color: var(--hot); }

  .card-desc {
    color: var(--ink-2);
  }

  /* pinned to the bottom so the years line up across a row of uneven cards */
  .card-year {
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--ink-3);
  }

  /* ---- 02 / everything else ---- */
  .idx-list {
    list-style: none;
    border-bottom: 2px solid var(--line);
  }

  .idx-row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line-2);
    text-decoration: none;
    color: inherit;
  }

  .idx-list li:first-child .idx-row {
    border-top: 2px solid var(--line);
  }

  .idx-no { color: var(--hot); }

  .idx-title {
    font-weight: 700;
    color: var(--ink);
  }

  .idx-row:hover .idx-title {
    color: var(--hot);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  /* second line, under the title. Runs to the row's end rather than stopping
     at the title column, and drops the 66ch measure cap that was cutting the
     longer ones short well before that. */
  .idx-desc {
    grid-column: 2 / -1;
    font-size: var(--text-small);
    color: var(--ink-2);
  }

  .idx-year {
    grid-row: 1;
    grid-column: 3;
    color: var(--ink-3);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .idx-row { grid-template-columns: 3rem minmax(0, 1fr) auto; }
  }
</style>
