---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../data/experience';
import type { ExperienceEntry } from '../data/experience';

// Experience, grouped by track; consecutive same-org entries fold into one
// org block so the Caterpillar three-role run reads as a progression.
interface OrgGroup {
  org: string;
  roles: ExperienceEntry[];
}

const groupByOrg = (entries: ExperienceEntry[]): OrgGroup[] => {
  const groups: OrgGroup[] = [];
  for (const entry of entries) {
    const last = groups[groups.length - 1];
    if (last && last.org === entry.org) {
      last.roles.push(entry);
    } else {
      groups.push({ org: entry.org, roles: [entry] });
    }
  }
  return groups;
};

const orgs = groupByOrg(experience);

// Entries are newest-first, so a group spans oldest start → newest end.
// Periods come in two shapes: "Aug 2025 - May 2026" and "Summer 2024,
// part-time through 2024-25". Take the start of the oldest and the end of the
// newest, whichever shape each one is.
const periodStart = (period: string): string => period.split(' - ')[0].split(',')[0].trim();

const periodEnd = (period: string): string => {
  // an open-ended role ends "ongoing", whatever shape the rest of it takes
  if (/ongoing\s*$/i.test(period)) return 'Ongoing';
  const tail = period.includes(' - ')
    ? period.split(' - ')[1]
    : period.includes('through ')
      ? period.split('through ')[1]
      : period;
  // "Ongoing, part-time" is a note on that one role, not on the org's span
  return tail.split(',')[0].trim();
};

const groupPeriod = (roles: ExperienceEntry[]): string => {
  const start = periodStart(roles[roles.length - 1]?.period ?? '');
  const end = periodEnd(roles[0]?.period ?? '');
  return start === end ? start : `${start} - ${end}`;
};

// An org with several internal teams reads as one job, not three. Where that
// job has a name, it is here; everything else keeps the role off its entry.
const ROLE_TITLE: Record<string, string> = {
  'UT Austin Research': 'Undergraduate Research Assistant',
  'Caterpillar Inc.': 'Software Engineering',
};

const roleTitle = (g: OrgGroup): string => ROLE_TITLE[g.org] ?? g.roles[0].role;


---

<BaseLayout
  title="Experience"
  description="Research at UT Austin, three teams at Caterpillar, and Formula SAE battery firmware before that."
>
  <section class="page-head">
    <div class="container">
      <div class="sec-head">
        <span class="sec-label">Experience</span>
        <span class="sec-aside">2023 – present</span>
      </div>
      <h1 class="display">Roles and teams</h1>
      <p class="page-lede">
        Research at UT Austin, three teams at Caterpillar, and extras.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="xp-list">
        {
          orgs.map((g) =>
                g.roles.length === 1 ? (
                  <li class="xp-entry prose">
                    <div class="xp-head">
                      <h2 class="xp-title">
                        <span class="xp-org">{g.org}</span>{' '}
                        <span class="xp-role">{g.roles[0].role}</span>
                      </h2>
                      <p class="label xp-period">{g.roles[0].period}</p>
                    </div>
                    <ul class="xp-bullets">
                      {g.roles[0].bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li class="xp-entry xp-group">
                    <div class="xp-head">
                      <h2 class="xp-title">
                        <span class="xp-org">{g.org}</span>{' '}
                        <span class="xp-role">{roleTitle(g)}</span>
                      </h2>
                      <p class="label xp-period">{groupPeriod(g.roles)}</p>
                    </div>
                    <ul class="xp-roles">
                      {g.roles.map((r) => (
                        <li class="xp-role-item prose">
                          <div class="xp-head">
                            <h3 class="xp-title">
                              <span class="xp-role-name">{r.role}</span>
                            </h3>
                            <p class="label xp-period">{r.period}</p>
                          </div>
                          <ul class="xp-bullets">
                            {r.bullets.map((b) => (
                              <li>{b}</li>
                            ))}
                          </ul>
                        </li>
                      ))}
                    </ul>
                  </li>
                )
          )
        }
      </ul>
    </div>
  </section>

</BaseLayout>

<style>

  .xp-list {
    list-style: none;
    border-bottom: 2px solid var(--line);
  }

  .xp-entry {
    padding-block: var(--space-6);
    border-top: 2px solid var(--line);
  }

  .xp-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-1) var(--space-6);
  }

  /* Real h2/h3 for the outline, set as the body-text line they always were:
     none of the global heading type, glow or flicker. */
  .xp-title {
    font: inherit;
    font-weight: 500;
    letter-spacing: normal;
    text-wrap: pretty;
    animation: none;
    text-shadow: none;
    max-width: none;
  }

  .xp-org {
    display: block;
    font-weight: 700;
    color: var(--ink);
  }

  .xp-role {
    display: block;
    color: var(--ink-2);
  }

  /* No nowrap: .xp-head wraps the period onto its own line whole when it
     doesn't fit beside the title, so it only breaks mid-phrase when a line
     of its own is too narrow ("Summer 2025, part-time through 2025-26" at
     390px), where nowrap pushed it off-screen. */
  .xp-period {
    color: var(--ink-3);
  }

  .xp-bullets {
    margin-top: var(--space-3);
  }

  .xp-bullets li + li {
    margin-top: var(--space-2);
  }

  /* .prose caps list items at the 66ch reading measure, which wrapped these
     well short of the column. A one-line bullet is not a paragraph. */
  .xp-bullets li {
    max-width: none;
  }

  .xp-roles {
    list-style: none;
    margin-top: var(--space-6);
    border-left: 2px solid var(--line);
    padding-left: var(--space-6);
  }

  .xp-role-item + .xp-role-item {
    margin-top: var(--space-8);
  }

  .xp-role-name {
    color: var(--ink);
    font-weight: 700;
  }

</style>
