---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publication, resumeUrl } from '../data/experience';
import { getFeaturedProjects } from '../data/projects';

// the action under the evidence links the baselines; this row carries the rest
const moreWork = getFeaturedProjects().filter((p) => p.slug !== 'serving-baselines');
---

<BaseLayout
  title="Systems for ML"
  description="Nathan Lemma: systems for machine learning. ECE at UT Austin, third author on a SOSP '26 paper, systems software at Caterpillar."
>
  <!-- ============ HERO — the instrument panel ============ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="sec-head">
        <span class="sec-label">Home</span>
        <span class="sec-aside">Austin, TX · ECE '27</span>
      </div>

      <div class="hero-split">
        <div class="panel-copy">
          <h1 class="display hero-title">Nathan Lemma</h1>
          <p class="hero-role">
            Systems for ML: GPU inference serving and its energy cost, as an undergraduate researcher
            in ECE at UT Austin. Firmware and data infrastructure at Caterpillar.
          </p>

          <!-- The evidence, one readout per row: the paper, then the rest of the
               featured work. Plain anchors, so all of it works without JS. -->
          <ul class="hero-proof">
            <li>
              <span class="label proof-key">{publication.venue}</span>
              <span class="proof-val">
                {publication.authorship}, {publication.note}:{' '}
                <a href={publication.paper}>“{publication.title}” ↗</a>
              </span>
            </li>
            <li>
              <span class="label proof-key">Featured</span>
              <span class="proof-val">
                {moreWork.map((p, i) => (
                  <>{i > 0 && ' · '}<a href={`/projects/${p.slug}`}>{p.title}</a></>
                ))}
              </span>
            </li>
          </ul>

          <div class="hero-actions">
            <a class="btn btn-sweep" href="/projects">Projects</a>
            <a class="hero-alt" href="/projects/serving-baselines">EnerTune: my contribution →</a>
            <a class="hero-alt" href={resumeUrl}>Résumé (PDF)</a>
          </div>
        </div>

        <!-- the nav's tomato, tipped over, filling the space beside the name -->
        <svg class="hero-mark" viewBox="0 0 48 48" aria-hidden="true">
          <rect x="10" y="16" width="28" height="24" rx="2" fill="var(--hot)" />
          <path class="stem" d="M20 16 Q24 8 28 16" stroke="var(--stem)" stroke-width="2.4" fill="none" stroke-linecap="round" />
          <path class="stem" d="M17 14 Q24 6 31 14" stroke="var(--stem)" stroke-width="2" fill="none" stroke-linecap="round" />
        </svg>
      </div>
    </div>
  </section>

  <!-- ============ DIRECTORY ============ -->
  <nav class="directory" aria-label="Sections">
    <a class="dir-row bracketed" href="/projects">
      <span class="dir-no">01</span>
      <span class="dir-name">Projects</span>
      <span class="dir-desc">GPU serving baselines, concurrent data structures and an OS kernel</span>
      <span class="dir-go" aria-hidden="true">→</span>
    </a>
    <a class="dir-row bracketed" href="/experience">
      <span class="dir-no">02</span>
      <span class="dir-name">Experience</span>
      <span class="dir-desc">Research at UT Austin, three teams at Caterpillar, Formula SAE before that</span>
      <span class="dir-go" aria-hidden="true">→</span>
    </a>
    <a class="dir-row bracketed" href="/about">
      <span class="dir-no">03</span>
      <span class="dir-name">About</span>
      <span class="dir-desc">Education, skills, scholarships, and what I do away from the screen</span>
      <span class="dir-go" aria-hidden="true">→</span>
    </a>
    <a class="dir-row bracketed" href="/contact">
      <span class="dir-no">04</span>
      <span class="dir-name">Contact</span>
      <span class="dir-desc">Hiring, research, or fun: replies within 24h</span>
      <span class="dir-go" aria-hidden="true">→</span>
    </a>
  </nav>

</BaseLayout>

<style>

  /* ---- hero ---- */
  .hero {
    position: relative;
    padding-block: var(--grid) calc(var(--grid) * 1.5);
  }

  .hero-grid { position: relative; }

  /* Below the breakpoint the copy has the row to itself and the mark is the
     first thing that should go: the header already carries one. */
  .hero-mark { display: none; }

  @media (min-width: 720px) {
    /* 60 words, 40 tomato */
    .hero-split {
      display: grid;
      grid-template-columns: 3fr 2fr;
      align-items: center;
      gap: var(--space-8);
    }

    .hero-mark {
      display: block;
      justify-self: center;
      align-self: start;
      margin-top: calc(var(--grid) * -1.95);
      /* px, not rem: a graphic, not text. At 19rem a 150% root text size
         grew it past its column, and rotated 35deg its box is ~1.4x wider
         still, which pushed 17px past the tube at 1440. */
      width: min(100%, 304px);
      height: auto;
      rotate: 35deg;
      filter: drop-shadow(0 0 16px var(--glow-hot));
    }

    .hero-mark .stem {
      filter: drop-shadow(0 0 6px color-mix(in oklch, var(--stem) 80%, transparent));
    }
  }

  .hero-title {
    /* sized to the panel column, not the page — it wants three lines here */
    font-size: clamp(1.9rem, 1rem + 2.4vw, 2.7rem);
    line-height: 1.16;
    max-width: 24ch;
    color: var(--ink);
  }

  /* On this page the header sits on the instrument, so the whole top of the
     page is one dark block instead of a light bar butted against a dark one.
     Scoped to index — these rules ship only with this page. */

  .hero-role {
    font-size: var(--text-lede);
    font-weight: 500;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 48ch;
    margin-top: var(--space-4);
  }

  /* ---- the evidence: two readout rows, key left, value right ---- */
  .hero-proof {
    list-style: none;
    margin-top: var(--space-4);
    border-top: 1px solid var(--line-2);
    font-size: var(--text-small);
    max-width: 60ch;
  }

  .hero-proof li {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-1);
    border-bottom: 1px solid var(--line-2);
  }

  .proof-key { color: var(--hot); }
  .proof-val { color: var(--ink-2); }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .btn-sweep {
    background: var(--sweep);
    color: var(--on-accent);
    box-shadow: 0 6px 18px -8px var(--hot);
  }
  .btn-sweep:hover { color: var(--on-accent); box-shadow: 0 10px 24px -8px var(--hot); }

  .hero-alt {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--amber);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--amber) 40%, transparent);
    padding-bottom: 0.15em;
  }
  .hero-alt:hover { color: var(--amber); border-bottom-color: var(--amber); }

  /* ---- the directory: three doorways, styled as rack rows ---- */
  .directory {
    position: relative;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4) var(--space-8);
  }

  .dir-row {
    /* the bracket pseudo-elements anchor here, not to the directory */
    position: relative;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: calc(var(--grid) * 0.75);
    text-decoration: none;
    background-color: var(--panel);
    background-image: var(--grain);
    background-size: 110px 110px;
    background-blend-mode: overlay;
    border: 1px solid var(--line);
    transition: border-color 160ms var(--ease), background-color 160ms var(--ease), transform 160ms var(--ease);
  }

  .dir-row:hover {
    background-color: var(--panel-2);
    border-color: color-mix(in oklch, var(--amber) 40%, var(--line));
    transform: translateX(3px);
  }

  .dir-no {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--hot);
  }

  .dir-name {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .dir-desc { color: var(--ink-2); font-size: var(--text-small); }

  .dir-go {
    font-family: var(--font-mono);
    color: var(--ink-3);
    transition: color 160ms var(--ease), transform 160ms var(--ease);
  }
  .dir-row:hover .dir-go { color: var(--amber); }
  .dir-row:hover .dir-name { color: var(--amber); }

  @media (max-width: 760px) {
    /* Four children into three columns: pushing the description onto its own
       row left the arrow to auto-place, and it landed in a third row under the
       number. Every child gets an explicit cell instead. */
    .dir-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      row-gap: var(--space-1);
      align-items: center;
    }

    .dir-no { grid-area: 1 / 1; }
    .dir-name { grid-area: 1 / 2; }
    .dir-go { grid-area: 1 / 3; }
    .dir-desc { grid-area: 2 / 2 / 3 / -1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dir-row:hover { transform: none; }
  }


    /* ---- Phone ---- */
  @media (max-width: 640px) {
    .hero { padding-block: var(--space-3) var(--space-6); }
    .hero-role { margin-top: var(--space-3); }
    .hero-proof { margin-top: var(--space-3); }
    .hero-proof li { grid-template-columns: 4.5rem minmax(0, 1fr); }
    .hero-actions { margin-top: var(--space-4); gap: var(--space-4); }
    .btn { width: 100%; justify-content: center; }
  }
</style>

