---
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
// 'page' only for the page itself. A project detail page keeps Projects lit,
// but as the section it sits in ('location'), not as the page being shown.
const current = (path: string) =>
  currentPath === path ? 'page' : currentPath.startsWith(`${path}/`) ? 'location' : undefined;

const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/experience', label: 'Experience' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

---

<header class="site-header">
  <div class="container hd-row">
    <a href="/" class="brand" aria-label="Nathan Lemma, home">
      <svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
        <rect x="10" y="16" width="28" height="24" rx="2" fill="var(--hot)" />
        <path class="stem" d="M20 16 Q24 8 28 16" stroke="var(--stem)" stroke-width="2.4" fill="none" stroke-linecap="round" />
        <path class="stem" d="M17 14 Q24 6 31 14" stroke="var(--stem)" stroke-width="2" fill="none" stroke-linecap="round" />
      </svg>
      <span class="brand-name">Nathan Lemma</span>
    </a>

    <!-- The chin's power button, for phones, which have no chin. Wired up
         with the other display controls in BaseLayout. -->
    <button class="power-btn hd-power" type="button" data-pref="design" aria-pressed="false" aria-label="CRT design" title="CRT design (off: light tablet)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="M12 3v8" />
        <path d="M7 6.5a7 7 0 1 0 10 0" />
      </svg>
    </button>

    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
    >
      <span class="menu-bar"></span>
      <span class="menu-bar"></span>
      <span class="menu-bar"></span>
    </button>

    <nav class="tabs" aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} class="tab" aria-current={current(link.href)}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="menu-scrim" hidden></div>

  <nav class="drawer" id="site-menu" aria-label="Menu" inert>
    <button class="menu-close" type="button" aria-label="Close menu">
      <span class="menu-bar"></span>
      <span class="menu-bar"></span>
    </button>
    {
      links.map((link) => (
        <a href={link.href} class="drawer-link" aria-current={current(link.href)}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  /* grid multiples, so the first line of the page below still lands on a rule */
  .site-header {
    border-bottom: 1px solid var(--line);
    padding-block: var(--grid) calc(var(--grid) * 1.5 - 1px);
  }

  .hd-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--ink);
  }

  /* the tomato — 1.5 cells square. The whole mark glows red; the green stem
     carries its own smaller green halo inside that. */
  .mark {
    width: calc(var(--grid) * 1.5);
    height: calc(var(--grid) * 1.5);
    flex: none;
    filter: drop-shadow(0 0 8px var(--glow-hot));
  }
  .stem { filter: drop-shadow(0 0 3px color-mix(in oklch, var(--stem) 80%, transparent)); }

  .brand-name {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: calc(var(--grid) * 0.6);
    line-height: var(--grid);
    color: var(--ink);
  }

  .tabs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* index-card tabs, each pinned at its own angle; 1.5 cells tall */
  .tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: calc(var(--grid) * 0.5);
    font-weight: 500;
    line-height: var(--grid);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
    text-decoration: none;
    background: transparent;
    border: 1px solid var(--line);
    padding: calc(var(--grid) * 0.25 - 1px) calc(var(--grid) * 0.5);
    cursor: pointer;
    transition: color 140ms var(--ease), box-shadow 140ms var(--ease);
  }

  .tab:hover {
    color: var(--amber);
    border-color: color-mix(in oklch, var(--amber) 50%, transparent);
  }

  /* the page itself, or the section a detail page sits in: same cue */
  .tab[aria-current] {
    color: var(--amber);
    border-color: color-mix(in oklch, var(--amber) 50%, transparent);
    box-shadow: inset 0 -2px 0 var(--hot);
  }

  /* Phones only (see the 720 block). Sized to sit level with the menu
     button's bars; margin-left:auto pairs it with that button at the right
     rather than letting space-between park it mid-row. */
  .hd-power {
    width: 32px;
    height: 32px;
    flex: none;
    margin-left: auto;
  }
  /* on the tablet's light canvas the chin's black puck reads as a hole */
  :global(html.flat) .hd-power {
    background: transparent;
    border-color: var(--line);
    box-shadow: none;
  }


  /* Phone: one compact bar. The tabs still wrap under the mark, but they stop
     being finger-sized rack labels that eat the first screen. */
  /* ---- the mobile menu ---- */
  .menu-btn,
  .menu-close {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: calc(var(--grid) * 1.5);
    height: calc(var(--grid) * 1.5);
    padding: 0;
    background: transparent;
    border: 1px solid var(--line);
    cursor: pointer;
  }

  .menu-bar {
    display: block;
    width: 17px;
    height: 1.5px;
    margin-inline: auto;
    background: var(--ink);
  }

  .menu-btn:hover,
  .menu-close:hover { border-color: color-mix(in oklch, var(--amber) 50%, transparent); }
  .menu-btn:hover .menu-bar,
  .menu-close:hover .menu-bar { background: var(--amber); }

  .menu-scrim {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: oklch(0 0 0 / 0.55);
    opacity: 0;
    transition: opacity 240ms var(--ease);
  }

  :global(html.menu-open) .menu-scrim { opacity: 1; }

  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 55;
    width: min(76vw, 290px);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-3);
    background-color: var(--panel);
    background-image: var(--grain);
    background-size: 110px 110px;
    background-blend-mode: overlay;
    border-left: 1px solid var(--line);
    /* clear of a notch or the home indicator where the phone has them */
    padding-top: calc(var(--space-3) + env(safe-area-inset-top, 0px));
    padding-right: calc(var(--space-3) + env(safe-area-inset-right, 0px));
    padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    visibility: hidden;
    translate: 100% 0;
    /* visibility flips instantly on the way in so the close button is
       focusable straight away, and is delayed on the way out so the panel
       can finish sliding */
    transition: translate 260ms var(--ease), visibility 0s linear 260ms;
  }

  :global(html.menu-open) .drawer {
    visibility: visible;
    translate: 0 0;
    transition: translate 260ms var(--ease), visibility 0s;
  }

  /* The drawer is fixed to the viewport, but in flat the header sits below
     the status bar. Without this the close button rides above the hamburger
     it replaces. */
  :global(html.flat) .drawer { padding-top: calc(var(--space-3) + var(--status-h) + env(safe-area-inset-top, 0px)); }

  .menu-close {
    align-self: flex-end;
    gap: 0;
    position: relative;
    margin-bottom: var(--space-2);
  }
  /* Absolutely positioned, so margin:auto can't centre them — pin to the
     middle and pull back by half. translate and rotate are separate
     properties, so both apply without one overwriting the other. */
  .menu-close .menu-bar {
    position: absolute;
    top: 50%;
    left: 50%;
    margin: 0;
    translate: -50% -50%;
  }

  .menu-close .menu-bar:first-child { rotate: 45deg; }
  .menu-close .menu-bar:last-child { rotate: -45deg; }

  .drawer-link {
    font-family: var(--font-mono);
    font-size: calc(var(--grid) * 0.6);
    line-height: calc(var(--grid) * 1.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .drawer-link:last-child { border-bottom: none; }
  .drawer-link:hover { color: var(--amber); }
  .drawer-link[aria-current] { color: var(--amber); }

  @media (prefers-reduced-motion: reduce) {
    .drawer, .menu-scrim { transition: none; }
  }

  /* Four tabs plus the wordmark need ~656px. Below that the row wrapped to two
     lines before the drawer took over, so the drawer starts at 720 — clear of
     the wrap point with room for font-loading and zoom differences. */
  /* Above the drawer breakpoint the drawer and scrim don't exist at all.
     Under the desktop warp filter the tube becomes their containing block,
     and a drawer parked at translate(100%) would count as scrollable
     overflow — a sideways scrollbar for a menu nobody can open. */
  @media (min-width: 721px) {
    .drawer,
    .menu-scrim { display: none; }
  }

  /* The drawer is JavaScript's to open, so the phone layout only swaps the
     tabs for it once html.js says the script is there (the head script sets
     it before first paint). Without it the tabs stay, as the compact plain
     labels below, wrapping under the name if they have to. */
  @media (max-width: 720px) {
    .site-header { padding-block: var(--space-3) var(--space-3); }
    :global(html.js) .tabs { display: none; }
    :global(html.js) .menu-btn,
    :global(html.js) .menu-close { display: flex; }
    :global(html.js) .hd-power { display: grid; }

    /* With the script, one line always: name, power, menu. */
    .hd-row { gap: var(--space-1) var(--space-2); }
    :global(html.js) .hd-row { flex-wrap: nowrap; }
    .mark { width: calc(var(--grid) * 1.15); height: calc(var(--grid) * 1.15); }
    /* The name stays at every width; at 320px with enlarged text it breaks
       onto two lines rather than pushing the buttons off the row. */
    .brand { min-width: 0; }
    .brand-name { font-size: 0.88rem; }

    .tabs { gap: var(--space-1) var(--space-3); flex-wrap: wrap; }
    .tab {
      background: transparent;
      border: none;
      padding: 0.2rem 0;
      font-size: 0.72rem;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
    .tab[aria-current] { box-shadow: inset 0 -2px 0 var(--hot); }
  }
</style>

<script>
  const html = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.menu-btn');
  const drawer = document.querySelector<HTMLElement>('.drawer');
  const scrim = document.querySelector<HTMLElement>('.menu-scrim');
  const closeBtn = document.querySelector<HTMLButtonElement>('.menu-close');

  if (toggle && drawer && scrim && closeBtn) {
    const isOpen = () => html.classList.contains('menu-open');

    // While the drawer is open everything else that can take focus is inert.
    // The skip link and the chin's power button live outside the header, so
    // they are named here alongside the header row, main and the footer.
    const background = () =>
      Array.from(document.querySelectorAll<HTMLElement>('.skip-link, .crt-power, .hd-row, main, .site-footer'));

    const focusables = () =>
      Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    // The scrim is hidden after its fade, by one timer at a time. Opening
    // cancels it: a hide left over from a close that a quick reopen overtook
    // used to fire mid-open and strip the backdrop from an open drawer.
    let hideTimer: number | undefined;

    // what last had focus inside the drawer, for a resize that closes it
    let lastInDrawer: HTMLElement | null = null;
    drawer.addEventListener('focusin', (e) => { lastInDrawer = e.target as HTMLElement; });

    const open = () => {
      window.clearTimeout(hideTimer);
      html.classList.add('menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      scrim.hidden = false;
      // inert keeps the drawer out of the tab order and the a11y tree while shut
      drawer.removeAttribute('inert');
      background().forEach((el) => el.setAttribute('inert', ''));
      closeBtn.focus();
    };

    const close = (returnFocus = true) => {
      if (!isOpen()) return;
      html.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('inert', '');
      // un-inert before focusing: the toggle lives inside the header row
      background().forEach((el) => el.removeAttribute('inert'));
      if (returnFocus) toggle.focus();
      // keep the scrim until it has faded (240ms), and only if still shut
      window.clearTimeout(hideTimer);
      const fade = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 260;
      hideTimer = window.setTimeout(() => { if (!isOpen()) scrim.hidden = true; }, fade);
    };

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    closeBtn.addEventListener('click', () => close());
    scrim.addEventListener('click', () => close());
    drawer.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });

    // Escape closes; Tab and Shift+Tab go round the drawer. Every step is
    // taken here rather than left to the browser: Safari's default keyboard
    // setting leaves links out of the native Tab order, so from the close
    // button a native Tab skipped all four links and left for the toolbar.
    // Focus found anywhere unexpected (outside the drawer, or on something
    // no longer in the list) restarts at the first item, or the last going
    // backwards. Ctrl/Alt/Cmd+Tab stay the browser's.
    addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') { close(); return; }
      if (e.key !== 'Tab' || e.altKey || e.ctrlKey || e.metaKey) return;
      const items = focusables();
      if (!items.length) return;
      e.preventDefault();
      const at = items.indexOf(document.activeElement as HTMLElement);
      const step = e.shiftKey ? -1 : 1;
      const next = at === -1 ? (e.shiftKey ? items.length - 1 : 0) : (at + step + items.length) % items.length;
      items[next].focus();
    });

    // A resize past the breakpoint closes the drawer: 721px is where the CSS
    // swaps it for the tab row. The toggle vanishes at that width too, so
    // focus goes to the tab for the link that had it (or the current tab)
    // instead of back to a button that is no longer there.
    matchMedia('(min-width: 721px)').addEventListener('change', (e) => {
      if (!e.matches || !isOpen()) return;
      const href = lastInDrawer?.getAttribute('href');
      close(false);
      const tabs = Array.from(document.querySelectorAll<HTMLElement>('.tabs .tab'));
      const target =
        tabs.find((t) => href && t.getAttribute('href') === href) ??
        tabs.find((t) => t.hasAttribute('aria-current')) ??
        tabs[0];
      target?.focus();
    });

    // Never leave a page with the drawer open: a back/forward cache restore
    // would bring it back open with the page behind it inert.
    addEventListener('pagehide', () => close(false));
  }
</script>
