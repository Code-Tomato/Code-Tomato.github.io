---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath === `${path}/`;

const links = [
  { href: '/projects', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const sun = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"/></svg>`;
const moon = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M20.5 13.3A8 8 0 1 1 10.7 3.5 6.3 6.3 0 0 0 20.5 13.3Z"/></svg>`;
---

<header class="header">
  <nav class="nav" aria-label="Main">
    <a href="/" class="brand" aria-label="Nathan Lemma — home">
      <svg class="mark" width="20" height="20" viewBox="0 0 16 16" aria-hidden="true">
        <path class="mark-stem" d="M8 6 V3" fill="none" stroke-width="1.8" />
        <path class="mark-stem" d="M8 3.4 L5.2 4.9 M8 3.4 L10.8 4.9" fill="none" stroke-width="1.6" stroke-linecap="square" />
        <rect x="3.25" y="6" width="9.5" height="9.5" rx="1.6" fill="var(--accent)" />
      </svg>
      <span class="brand-name">Nathan Lemma</span>
    </a>

    <div class="nav-right">
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="nav-link" aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="theme-toggle theme-desktop" type="button" aria-label="Toggle light and dark">
        <span class="i-sun" set:html={sun} />
        <span class="i-moon" set:html={moon} />
      </button>
    </div>

    <button class="theme-toggle theme-mobile" type="button" aria-label="Toggle light and dark">
      <span class="i-sun" set:html={sun} />
      <span class="i-moon" set:html={moon} />
    </button>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    display: flex;
    justify-content: center;
    padding: 0.75rem 1.2rem;
    pointer-events: none;
  }

  .nav {
    width: min(100%, var(--container));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* solid pills */
  .brand,
  .nav-right {
    pointer-events: auto;
    min-height: 3rem;
    display: flex;
    align-items: center;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid color-mix(in oklch, var(--ink) 12%, transparent);
    box-shadow: var(--pill-sh);
  }

  .brand {
    gap: 0.5rem;
    padding: 0.34rem 0.95rem 0.34rem 0.8rem;
    text-decoration: none;
    color: var(--ink);
  }
  .mark { flex: none; align-self: center; transform: translateY(-2px); filter: drop-shadow(0 2px 3px color-mix(in oklch, var(--accent) 40%, transparent)); }
  .mark-stem { stroke: var(--leaf); }
  .brand-name { font-weight: 680; letter-spacing: -0.01em; font-size: 0.95rem; line-height: 1; color: var(--ink); }

  .nav-right { gap: 0.25rem; padding: 0.3rem 0.35rem; }
  .nav-list { display: flex; align-items: center; gap: 0.1rem; list-style: none; }
  .nav-link {
    display: block;
    font-size: 0.9rem;
    font-weight: 540;
    color: var(--ink);
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    transition: color 160ms var(--ease), background 160ms var(--ease);
  }
  .nav-link:hover { color: var(--accent); }
  .nav-link[aria-current='page'] { color: var(--accent); background: color-mix(in oklch, var(--accent) 12%, transparent); }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: transparent;
    border: none;
    color: var(--ink);
    cursor: pointer;
    transition: background 160ms var(--ease), color 160ms var(--ease);
  }
  .theme-toggle:hover { background: color-mix(in oklch, var(--accent) 14%, transparent); color: var(--accent); }
  .theme-toggle .i-sun,
  .theme-toggle .i-moon { display: grid; place-items: center; }
  .theme-toggle .i-moon { display: none; }
  :global([data-theme='dark']) .theme-toggle .i-sun { display: none; }
  :global([data-theme='dark']) .theme-toggle .i-moon { display: grid; }

  .theme-mobile { display: none; }

  /* mobile: brand circle top-left · toggle circle top-right · links float at the bottom */
  @media (max-width: 720px) {
    .header { pointer-events: none; padding: 0.8rem 0.9rem; }
    .nav { position: static; }

    .brand {
      pointer-events: auto;
      position: fixed; top: 0.85rem; left: 0.95rem;
      width: 48px; height: 48px; justify-content: center; gap: 0; padding: 0;
    }
    .brand-name { display: none; }

    .theme-desktop { display: none; }

    .nav-right {
      pointer-events: auto;
      position: fixed; left: 0; right: 0; bottom: 1rem; top: auto;
      margin-inline: auto; width: max-content;
    }

    .theme-mobile {
      display: grid;
      pointer-events: auto;
      position: fixed; top: 0.85rem; right: 0.95rem;
      width: 48px; height: 48px; border-radius: 999px;
      background: var(--paper);
      border: 1px solid color-mix(in oklch, var(--ink) 12%, transparent);
      box-shadow: var(--pill-sh);
    }
  }
</style>

<script>
  const html = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

  const syncLabel = () => {
    const dark = html.getAttribute('data-theme') === 'dark';
    toggles.forEach((t) => t.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme'));
  };
  syncLabel();

  toggles.forEach((t) =>
    t.addEventListener('click', () => {
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      syncLabel();
    })
  );
</script>
