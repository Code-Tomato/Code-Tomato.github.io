---
/**
 * Project detail as a poster spec sheet: heavy head, numbered sections,
 * square geometry. Content comes verbatim from projects.ts.
 */
import { getProjectBySlug, type Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const isArchived = project.tier === 'archived';
const year = project.date.slice(0, 4);

const links = [
  { label: 'GitHub ↗', href: project.links.github },
  { label: 'Write-up ↗', href: project.links.documentation },
  { label: 'Paper ↗', href: project.links.paper },
  { label: 'Demo ↗', href: project.links.demo },
].filter((link): link is { label: string; href: string } => Boolean(link.href));

const meta = [
  project.dateDisplay,
  project.status,
  ...(project.teamProject ? ['Team project'] : []),
  project.category[0],
].filter(Boolean);

const seeAlso = project.seeAlso
  .map((slug) => getProjectBySlug(slug))
  .filter((p): p is Project => Boolean(p));

let sectionIndex = 0;
const nn = () => String(++sectionIndex).padStart(2, '0');
const secOverview = nn();
const secImpact = project.impact ? nn() : null;
const secStack = nn();
const secLinks = links.length > 0 ? nn() : null;
const secRelated = seeAlso.length > 0 ? nn() : null;
---

<article class:list={['detail', { 'is-archived': isArchived }]}>
  <div class="container">
    <a href="/projects" class="label back-link">← All work</a>

    <header class="detail-head">
      {isArchived && <p class="label archive-stamp">Archive · {year}</p>}
      <h1>{project.title}</h1>
      <p class="detail-result">{project.headline}</p>
      <p class="label detail-meta">{meta.join(' · ')}</p>
    </header>

    <section class="detail-sec" aria-labelledby="sec-overview">
      <div class="sec-head">
        <span class="sec-index">{secOverview}</span>
        <span class="sec-label" id="sec-overview">Overview</span>
      </div>
      <div class="prose detail-prose">
        <p class="detail-lede">{project.longDescription}</p>
        <ul>
          {project.keyFeatures.map((feature) => <li>{feature}</li>)}
        </ul>
      </div>
    </section>

    {
      project.impact && (
        <section class="detail-sec" aria-labelledby="sec-impact">
          <div class="sec-head">
            <span class="sec-index">{secImpact}</span>
            <span class="sec-label" id="sec-impact">Impact</span>
          </div>
          <div class="frame impact-frame">
            <p>{project.impact}</p>
          </div>
        </section>
      )
    }

    <section class="detail-sec" aria-labelledby="sec-stack">
      <div class="sec-head">
        <span class="sec-index">{secStack}</span>
        <span class="sec-label" id="sec-stack">Stack &amp; topics</span>
      </div>
      <ul class="tag-row" aria-label="Topics and stack">
        {project.tags.map((tag) => <li class="label tag">{tag}</li>)}
      </ul>
    </section>

    {
      links.length > 0 && (
        <section class="detail-sec" aria-labelledby="sec-links">
          <div class="sec-head">
            <span class="sec-index">{secLinks}</span>
            <span class="sec-label" id="sec-links">Links</span>
          </div>
          <nav class="links-row" aria-label="Project links">
            {links.map((link) => (
              <a class="btn btn-secondary" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            ))}
          </nav>
        </section>
      )
    }

    {
      seeAlso.length > 0 && (
        <section class="detail-sec" aria-labelledby="sec-related">
          <div class="sec-head">
            <span class="sec-index">{secRelated}</span>
            <span class="sec-label" id="sec-related">Related</span>
          </div>
          <ul class="related-row">
            {seeAlso.map((p) => (
              <li><a class="link-dir" href={`/projects/${p.slug}`}>{p.title} →</a></li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</article>

<style>
  .detail {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) var(--section-pad);
  }

  .back-link {
    display: inline-block;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.55rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  /* ---- head ---- */
  .detail-head {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 4px solid var(--line);
  }

  .archive-stamp {
    color: var(--ink-3);
    margin-bottom: var(--space-3);
  }

  .detail-result {
    margin-top: var(--space-6);
    font-size: var(--text-lede);
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink);
    max-width: 44ch;
    text-wrap: balance;
  }

  .detail-meta {
    margin-top: var(--space-4);
    color: var(--ink-3);
  }

  /* ---- sections ---- */
  .detail-sec {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  .detail-sec .sec-head {
    margin-bottom: var(--space-6);
    border-top-width: 2px;
  }

  .detail-lede {
    font-size: var(--text-lede);
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .detail-prose ul {
    margin-top: var(--space-6);
  }

  .detail-prose li + li {
    margin-top: var(--space-2);
  }

  /* Archived projects stay quiet: markers drop the accent. */
  .is-archived .detail-prose :global(li)::before {
    background: var(--ink-3);
  }

  .impact-frame {
    padding: var(--space-6);
    max-width: var(--measure);
    border-left: 8px solid var(--accent);
  }

  .is-archived .impact-frame {
    border-left-color: var(--line);
  }

  /* ---- tags ---- */
  .tag-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    color: var(--ink);
    border: 2px solid var(--line);
    padding: 0.35rem 0.6rem;
    white-space: nowrap;
  }

  /* ---- links ---- */
  .links-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .related-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
  }

  .related-row a {
    display: inline-block;
    padding-block: 0.55rem;
  }
</style>
