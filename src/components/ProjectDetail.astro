---
/**
 * Project detail, built from the same parts as every other page: a page-head
 * with its eyebrow, then numbered .section-tight blocks. Content comes
 * verbatim from projects.ts.
 */
import ProjectFigure, { FIGURE_SLUGS } from './ProjectFigure.astro';
import { type Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const hasFigure = FIGURE_SLUGS.includes(project.slug);

const textLinks = [
  { label: 'Write-up ↗', href: project.links.documentation },
  { label: 'Paper ↗', href: project.links.paper },
].filter((link): link is { label: string; href: string } => Boolean(link.href));

const hasLinks = Boolean(project.links.github) || textLinks.length > 0;

// the date sits beside the title now, so this is what is left
const meta = [...(project.teamProject ? ['Team project'] : []), project.category[0]].filter(Boolean);

---

<!-- Page head -->
<section class="page-head">
  <div class="container">
    <div class="sec-head">
      <a class="sec-label back-link" href="/projects">← All projects</a>
      {
        hasLinks && (
          <span class="sec-aside link-set">
            <span class="link-set-label">Links:</span>
            {project.links.github && (
              <a
                class="gh-link"
                href={project.links.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.title} on GitHub`}
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
              </a>
            )}
            {textLinks.map((link) => (
              <a class="link-dir" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            ))}
          </span>
        )
      }
    </div>
    <div class="title-row">
      <h1 class="display">{project.title}</h1>
      <p class="label detail-date">
        <time datetime={project.date}>{project.dateDisplay}</time>
      </p>
    </div>
    <p class="label detail-meta">{meta.join(' · ')}</p>

    <div class:list={['head-grid', { 'has-figure': hasFigure }]}>
      <p class="lede page-lede" set:html={project.description} />
      {hasFigure && <ProjectFigure slug={project.slug} />}
    </div>

    <div class="tag-block">
      <div class="sec-head">
        <span class="sec-label" id="sec-skills">Skills</span>
      </div>
      <ul class="tag-row" aria-labelledby="sec-skills">
        {project.tags.map((tag) => <li class="label tag">{tag}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  /* No nowrap: .title-row moves the date to its own line whole whenever it
     doesn't fit beside the title, so it only ever breaks when even a line
     of its own is too narrow (320px with enlarged text), not off-screen. */
  .detail-date {
    color: var(--ink-3);
  }

  /* sits in the aside slot, so .sec-head's margin-left:auto still right-aligns it */
  .link-set {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .link-set-label { color: var(--ink-3); }

  /* global.css hides every .sec-aside on phones; this one is the project's
     links, so it stays and drops to its own row under the back link. */
  @media (max-width: 640px) {
    .sec-head { flex-wrap: wrap; }
    .sec-head .sec-aside.link-set {
      display: flex;
      flex-wrap: wrap;
      flex-basis: 100%;
      margin-left: 0;
      row-gap: var(--space-1);
    }
  }

  .gh-link {
    display: inline-flex;
    color: var(--ink-3);
  }

  .gh-link svg {
    width: 1.35em;
    height: 1.35em;
  }

  .gh-link:hover { color: var(--amber); }

  /* inherits .sec-label's mono caps; only the link bits differ */
  .back-link { text-decoration: none; }
  .back-link:hover { color: var(--hot); }

  /* Title left, date hard right on the same baseline; both span the full
     width above the partition. */
  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  /* A one-word title wider than the screen ("Keyboard2x2", "Eigensolver" in
     the mono h1 at 320px with 150% text) may break inside the word; it only
     does when the word can't fit a line of its own. "anywhere", not
     "break-word", because only it lowers the min-content width this flex item
     is sized from, so the h1 can shrink to the row instead of pushing past it. */
  .title-row h1 { overflow-wrap: anywhere; }

  .detail-meta {
    margin-top: var(--space-2);
    color: var(--ink-3);
  }

  .head-grid {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-3);
  }

  /* .page-lede carries its own top margin for pages where it follows an h1;
     here the grid already sets the gap. */
  .head-grid .page-lede { margin-top: 0; }


  /* Even split: the figure gets as much room as the title block. */
  @media (min-width: 720px) {
    .head-grid.has-figure {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: var(--space-8);
    }
  }

  /* its own full-width band under the partition; the sec-head rule does the
     separating, so it needs far less air above it than a bare row did */
  .tag-block { margin-top: var(--space-6); }

  .tag-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* 1px, like the header tabs; this was the last 2px border on the site. */
  .tag {
    color: var(--ink-2);
    border: 1px solid var(--line);
    padding: calc(var(--grid) * 0.25 - 1px) calc(var(--grid) * 0.5);
  }

</style>
