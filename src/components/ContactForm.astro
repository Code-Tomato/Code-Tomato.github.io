---
// Formspree-backed contact form. Submits via fetch so success/error shows
// in place; falls back to a native POST when JS is unavailable.
// Spam control: honeypot field (_gotcha) instead of third-party captcha.
---

<form class="contact-form" id="contact-form" action="https://formspree.io/f/movkydqd" method="POST" novalidate>
  <div class="form-field">
    <label for="contact-name">Name</label>
    <input type="text" id="contact-name" name="name" required autocomplete="name" aria-describedby="error-name" />
    <p class="field-error small" id="error-name" hidden>Please enter your name.</p>
  </div>

  <div class="form-field">
    <label for="contact-email">Email</label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      aria-describedby="error-email"
    />
    <p class="field-error small" id="error-email" hidden>Please enter your email so I can reply.</p>
  </div>

  <div class="form-field">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" required rows="6" aria-describedby="error-message"></textarea>
    <p class="field-error small" id="error-message" hidden>Please enter a message.</p>
  </div>

  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />

  <div class="form-actions">
    <button type="submit" class="btn btn-primary" id="contact-submit">Send message</button>
    <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
  </div>
</form>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-6);
    max-width: 36rem;
  }

  .form-field {
    display: grid;
    gap: var(--space-2);
  }

  label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink);
  }

  input,
  textarea {
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper);
    border: 2px solid var(--line-input);
    padding: 0.75rem 0.85rem;
    transition: border-color 100ms var(--ease);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--ink-3);
  }

  input:hover,
  textarea:hover {
    border-color: var(--ink);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 1px;
    border-color: var(--ink);
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .field-error {
    color: var(--accent);
    font-weight: 600;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .form-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .form-status {
    font-size: var(--text-small);
    color: var(--ink-2);
    margin: 0;
  }

  .form-status.is-error {
    color: var(--accent);
    font-weight: 600;
  }

  button[disabled] {
    opacity: 0.6;
    cursor: default;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;

  const fields = [
    { input: 'contact-name', error: 'error-name' },
    { input: 'contact-email', error: 'error-email' },
    { input: 'contact-message', error: 'error-message' },
  ];

  const validate = () => {
    let ok = true;
    for (const f of fields) {
      const input = document.getElementById(f.input) as HTMLInputElement | HTMLTextAreaElement | null;
      const error = document.getElementById(f.error);
      const valid = !!input && input.checkValidity();
      error?.toggleAttribute('hidden', valid);
      input?.setAttribute('aria-invalid', String(!valid));
      if (!valid) ok = false;
    }
    return ok;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate() || !status || !submit) return;

    status.classList.remove('is-error');
    status.textContent = 'Sending your message…';
    submit.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      status.textContent = "Message sent — thank you. I'll reply soon.";
      form.reset();
    } catch {
      status.classList.add('is-error');
      status.textContent =
        "Your message didn't send. Check your connection and try again, or email me at nlemma@utexas.edu.";
    } finally {
      submit.disabled = false;
    }
  });
</script>
